<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaApplication1.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="AvaloniaApplication1.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Background="#2D5A27"
        Title="Gra w Pana">

    <Window.Resources>
        <vm:ColorConverter x:Key="ColorConverter"/>
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:CardViewModel">
            <Button Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).PlayCardCommand}"
                    CommandParameter="{Binding}"
            Background="Transparent"
            Padding="0">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" 
                    CornerRadius="8" Width="65" Height="90" BoxShadow="2 2 5 0 #20000000">
                <Grid RowDefinitions="Auto, *" Margin="5">
                    <TextBlock Grid.Row="0" Text="{Binding Rank}" FontSize="14" FontWeight="Bold"
                               Foreground="{Binding CardColor, Converter={StaticResource ColorConverter}}"/>
                    <TextBlock Grid.Row="1" Text="{Binding Suit}" FontSize="32" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding CardColor, Converter={StaticResource ColorConverter}}"/>
                </Grid>
            </Border>
            </Button>
        </DataTemplate>
    </Window.Resources>

   <Grid RowDefinitions="150, *, Auto, 150">
    
    <!-- RĘKA GRACZA 2 -->
    <Border Grid.Row="0" Background="#30000000" Padding="10">
        <ItemsControl ItemsSource="{Binding Player2Hand}" 
                      ItemTemplate="{StaticResource CardTemplate}"
                      IsEnabled="{Binding IsGameActive}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="-25" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Border>

    <!-- STATUS TURY I STOS -->
    <Border Grid.Row="1" Margin="20" BorderBrush="#44FFFFFF" BorderThickness="2" CornerRadius="15">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding GameStatus}" Foreground="Yellow" FontSize="20" HorizontalAlignment="Center" Margin="5"/>
            <ItemsControl ItemsSource="{Binding TableStack}" 
                          ItemTemplate="{StaticResource CardTemplate}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="-30" HorizontalAlignment="Center"/> 
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>

    <!-- PRZYCISK DOBIERANIA -->
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="10">
        <Button Content="Dobierz 3 karty" Command="{Binding DrawCardsCommand}" Background="#CC0000" Foreground="White" IsEnabled="{Binding IsGameActive}"/>
    </StackPanel>

    <!-- RĘKA GRACZA 1 -->
    <Border Grid.Row="3" Background="#30000000" Padding="10">
        <ItemsControl ItemsSource="{Binding Player1Hand}" 
                      ItemTemplate="{StaticResource CardTemplate}"
                      IsEnabled="{Binding IsGameActive}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="-25" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Border>
</Grid>
</Window>